# Normalize line endings and text handling.
#
# The repository previously contained a mix of CRLF and LF files. All text
# files are now stored with LF in the repository; Git converts them on
# checkout according to `eol` if needed.
#
# See https://git-scm.com/docs/gitattributes

# Default: let Git detect text files and normalize to LF in the repository.
* text=auto eol=lf

# Explicit text files
*.py   text eol=lf
*.pyi  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sh   text eol=lf
*.cfg  text eol=lf
*.ini  text eol=lf
*.txt  text eol=lf
Dockerfile      text eol=lf
*.dockerfile    text eol=lf
.gitattributes  text eol=lf
.gitignore      text eol=lf
.editorconfig   text eol=lf

# Binary files (never normalize / diff as text)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.zip   binary
*.gz    binary
*.db    binary
*.sqlite binary
*.sqlite3 binary

# Keep lockfiles as generated by their tools
uv.lock                 text eol=lf
frontend/package-lock.json text eol=lf
