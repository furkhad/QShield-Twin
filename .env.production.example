# QShield Twin — production environment template.
#
#   cp .env.production.example .env.production
#   # generate strong secrets, then edit the values below
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# NEVER commit a filled-in `.env.production` (it is git-ignored) and never pass
# these values as Docker build arguments — they must not end up in image layers.
#
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"   # SECRET_KEY
#   python -c "import secrets; print(secrets.token_urlsafe(32))"   # API_TOKEN
#   python -c "import secrets; print(secrets.token_urlsafe(24))"   # POSTGRES_PASSWORD

# --- Image selection --------------------------------------------------------
# Tag of the images to run. Use a released version once published to GHCR, or
# `local` while building images on this machine (scripts/build-prod-images.sh).
QSHIELD_IMAGE_TAG=local

# --- Required secrets (NO defaults; the stack refuses to start without them) -
# Application secret. Required; must not be a placeholder.
SECRET_KEY=
# Shared deployment token. Required. Injected by the frontend proxy server-side
# as X-API-Token. This is a deployment-level gate, NOT user authentication.
API_TOKEN=
# PostgreSQL password for the application user.
POSTGRES_PASSWORD=

# --- Database ---------------------------------------------------------------
POSTGRES_DB=qshield
POSTGRES_USER=qshield

# --- Host configuration -----------------------------------------------------
# Hostnames the backend accepts (JSON array, no "*"). Requests are proxied with
# the browser's Host header preserved, so this must list every host users type.
# JSON: ["localhost","127.0.0.1"]   |   production: ["qshield.example.com"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Hostnames the frontend edge proxy accepts (space-separated).
QSHIELD_ALLOWED_HOSTS=localhost 127.0.0.1
# nginx server_name; "_" is fine for a default/catch-all server.
QSHIELD_SERVER_NAME=_

# CORS origins. All browser traffic is same-origin through the proxy, so this
# normally stays empty (JSON array; must never contain "*").
CORS_ORIGINS=[]

# --- Network exposure -------------------------------------------------------
# Loopback by default: only reachable from this host. Set to 0.0.0.0 to expose
# the service, and terminate TLS (or add real user authentication) in front.
QSHIELD_BIND_ADDRESS=127.0.0.1
QSHIELD_FRONTEND_PORT=8080

# --- Optional tuning --------------------------------------------------------
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BYTES=1000000
MAX_WS_CONNECTIONS=50
