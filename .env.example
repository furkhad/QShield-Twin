# QShield Twin backend configuration.
# Copy to `.env` and adjust. In production (ENVIRONMENT=production) the app
# refuses to start with placeholder secrets, DEBUG=true, wildcard CORS/hosts,
# or a SQLite database.

# Application
APP_NAME=QShield Twin
APP_VERSION=0.2.0
ENVIRONMENT=development
DEBUG=false

# Security (REQUIRED in production; use a long random value)
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# Shared API token protecting state-changing/sensitive endpoints and the
# WebSocket stream. Leave unset for frictionless local development; it is
# REQUIRED in production. The token is a deployment-level gate, NOT user
# authentication: it is held server-side (the Vite dev proxy / reverse proxy
# forwards it as the `X-API-Token` header) and must never be exposed to the
# browser (never put it in a VITE_-prefixed variable).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_TOKEN=change-me-in-production

# Request / connection protection (sane defaults; tune for your deployment).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BYTES=1000000
MAX_WS_CONNECTIONS=50

# Hosts allowed to serve the API. Use explicit hosts in production.
# Example: ALLOWED_HOSTS=["qshield.example.com"]
ALLOWED_HOSTS=["*"]

# CORS origins permitted to call the API (the Vite dev server by default).
CORS_ORIGINS=["http://localhost:5173"]

# Database
# Development default (SQLite). In production (ENVIRONMENT=production) a
# networked database is required and SQLite is rejected at startup. The
# PostgreSQL driver (psycopg 3) is installed in the backend image, e.g.:
#   DATABASE_URL=postgresql+psycopg://qshield:<password>@db:5432/qshield
# See docs/DEPLOYMENT.md and docker-compose.prod.yml.
DATABASE_URL=sqlite:///./qshield_twin.db

# Logging
LOG_LEVEL=INFO

# Research / simulation
RESEARCH_MODE=false
SIMULATION_SPEED=1.0
# Optional fixed PRNG seed for reproducible runs (leave empty for non-seeded).
# RANDOM_SEED=42

# Resource limits for user-controlled operations
MAX_DEVICES_PER_REQUEST=1000
MAX_GHOSTS_PER_ATTACK=1000
