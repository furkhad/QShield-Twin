# QShield Twin frontend configuration (Vite).
# Copy to `.env.local` to override.
#
# SECURITY: anything prefixed `VITE_` is inlined into the browser bundle and is
# therefore PUBLIC. Never put a secret (such as the backend API token) in a
# VITE_-prefixed variable. The backend token below is intentionally NOT prefixed,
# so only the Vite dev-server (Node) process can read it and inject it into
# proxied requests.

# Base URL of the backend API. Leave empty to use the same origin (recommended;
# in dev the Vite proxy forwards /api to the backend below).
# VITE_API_BASE_URL=http://localhost:8000

# Explicit WebSocket stream URL. If unset it is derived from the current origin
# and routed through the Vite dev proxy in development.
# VITE_WS_URL=ws://localhost:8000/api/v1/ws/stream

# Dev-only: where the Vite dev server proxies /api (and the WebSocket) to.
VITE_API_PROXY_TARGET=http://localhost:8000

# Backend API token, held by the DEV SERVER (Node), not the browser. When the
# backend enforces a token, set this to the same value so the dev proxy can add
# the `X-API-Token` header to proxied /api requests and the WebSocket upgrade.
# Leave unset for local development, where the backend is open.
# In production, do NOT build this into the frontend; instead configure your
# reverse proxy to inject the header (see docs/ARCHITECTURE.md).
# QSHIELD_API_TOKEN=change-me-in-production
