# QShield Twin production frontend server configuration.
#
# This file is a template. The nginx image's entrypoint renders it with
# `envsubst` (restricted to `QSHIELD_`-prefixed variables, see
# NGINX_ENVSUBST_FILTER in frontend/Dockerfile.prod) into
# /etc/nginx/conf.d/default.conf when the container starts.
#
# Responsibilities:
#   * serve the compiled Vite bundle (no dev server),
#   * reverse-proxy `/api` (REST) and `/api/v1/ws/stream` (WebSocket) to the
#     backend,
#   * inject the shared deployment token server-side (`X-API-Token`).
#
# SECURITY
#   * `QSHIELD_API_TOKEN` is a server-side secret. It is injected here as a
#     request header and must never appear in the served HTML/JS/CSS (the bundle
#     is static and cannot read it). `npm run check:secrets` guards the bundle.
#   * This header is a *deployment-level gate*, NOT user authentication: every
#     visitor of this site is proxied with the same token. There is no per-user
#     identity or RBAC. Put real user authentication in front of this server
#     (e.g. an OAuth2/SSO proxy) before exposing it beyond a trusted network.

# WebSocket upgrade mapping. Must live in the http context (not a server block);
# this file is rendered into /etc/nginx/conf.d/, which nginx includes inside the
# http context.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Listen on an unprivileged port so the container can run without extra
# privileges; publish it to the host from Compose.
server {
    listen 8080;
    server_name ${QSHIELD_SERVER_NAME};

    root /usr/share/nginx/html;
    index index.html;

    # Do not advertise the nginx version.
    server_tokens off;

    # Modest, deployment-appropriate limits.
    client_max_body_size 2m;

    # Security headers. The bundle is self-contained (no inline scripts, no
    # remote fonts/CDNs), so a strict content policy is safe here. `connect-src`
    # allows the same-origin `/api` REST + WebSocket calls.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self' ws: wss:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    # Container/liveness probe: does not touch the backend.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Reverse proxy for the API (REST and WebSocket share this prefix).
    location /api/ {
        proxy_pass http://${QSHIELD_BACKEND_HOST}:${QSHIELD_BACKEND_PORT};
        proxy_http_version 1.1;

        # Inject the shared deployment token server-side.
        proxy_set_header X-API-Token "${QSHIELD_API_TOKEN}";

        # Preserve the original Host so the backend's TrustedHostMiddleware sees
        # the host the browser actually used (e.g. localhost:8080).
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket upgrade support (used by /api/v1/ws/stream). The `map` for
        # $connection_upgrade is defined at the top of this file.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Long-lived WebSocket streams must not be cut off by proxy timeouts.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # Hashed build assets are immutable and safe to cache aggressively.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback: every other path serves the app shell.
    location / {
        try_files $uri /index.html;
    }
}
